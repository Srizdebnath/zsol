# zsol 0.2 environment (light-client backend). cp .env.example .env and fill in.
# Every variable below is read by the code; unset means the default shown.
# Never commit .env. No inline comments: some loaders keep them as part of the value.

# --- chain (zsol, zsol-credit, zsol-mcp) ---
# lightwalletd host:port (TLS except loopback)
ZSOL_LWD=testnet.zec.rocks:443
# test | main
ZSOL_NETWORK=test
# tracing filter for zsol and zsol-credit (zsol-registry / zsol-mcp use RUST_LOG)
ZSOL_LOG=info
# age identity for seed.age; default <wallet dir>/identity.txt
# ZSOL_AGE_IDENTITY=

# --- claims registry (zsol-registry) ---
ZSOL_REGISTRY_BIND=127.0.0.1:2730
# required by zsol-registry itself; `zsol up` defaults it to ~/.zsol/registry.sqlite
ZSOL_REGISTRY_DB=
ZSOL_REGISTRY_MAX_BODY=64000
ZSOL_REGISTRY_RATE_PER_SEC=5
ZSOL_REGISTRY_RATE_BURST=10

# --- Credit Desk (zsol-credit) ---
# underwriter wallet dir (zsol wallet init --role underwriter); required
ZSOL_CREDIT_DIR=
ZSOL_CREDIT_POLICY=config/credit-policy.json
ZSOL_CREDIT_BIND=127.0.0.1:8090
# Bitrefill developer API key (test products); required by zsol-credit. Secret: .env only.
BITREFILL_API_KEY=

# --- MCP gateway (zsol-mcp) ---
# this agent's wallet dir; required
ZSOL_WALLET_DIR=
# bind streamable HTTP (POST /mcp); unset = stdio only
ZSOL_MCP_HTTP_BIND=127.0.0.1:8099
# 1 = HTTP only, no stdio loop (daemon mode)
ZSOL_MCP_NO_STDIO=0
ZSOL_REGISTRY_URL=http://127.0.0.1:2730
ZSOL_CREDIT_URL=http://127.0.0.1:8090
# default: wallet dir name
# ZSOL_VERIFIER_ID=
# must be exactly 1 for tools that broadcast (FR-5.2); leave unset for verifiers
# ZSOL_ALLOW_SPEND=1
ZSOL_SPEND_CAP_ZAT=10000000
ZSOL_MIN_CONF=1

# --- zsol up (FR-8.1, local only; also honours the bind/dir vars above) ---
# repo root and sibling-binary dir; defaults derive from the zsol binary location
# ZSOL_ROOT=
# ZSOL_BIN_DIR=
# view-only wallet of the public verifier gateway; default ~/.zsol/public-verifier
# ZSOL_PUBLIC_VERIFIER_DIR=
ZSOL_WEB_PORT=3000

# --- web (Next.js; NEXT_PUBLIC_* are inlined at `pnpm build`) ---
NEXT_PUBLIC_REGISTRY_URL=http://127.0.0.1:2730
NEXT_PUBLIC_MCP_URL=http://127.0.0.1:8099
NEXT_PUBLIC_CREDIT_URL=http://127.0.0.1:8090
# tx explorer URL prefix (txid appended); empty = no links
NEXT_PUBLIC_EXPLORER_TX=
