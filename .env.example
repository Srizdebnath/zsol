# ─── zsol environment (cp .env.example .env; fill from docs/OPERATIONS.md) ───

ZSOL_NETWORK=testnet

# Z3 attach (see docker/compose.zsol.yml; cookie volume is read-only)
ZEBRA_RPC_URL=http://zebra:18232
ZALLET_RPC_URL=http://zallet:18264
Z3_COOKIE_PATH=/var/run/auth/.cookie

# Wallet account numbers (ZIP-32). Commerce stays in 0; attestation ONLY in the dedicated account:
ZSOL_ATTEST_ACCOUNT=9
ZSOL_MIN_ANCHOR_ZATOSHI=10000       # dust floor for anchors / claims
ZSOL_MAX_ATTESTATION_AGE_HOURS=24   # T2 continuity: how long a verification lasts

# Registry (public claims store; never stores keys)
ZSOL_REGISTRY_BIND=0.0.0.0:2730
ZSOL_REGISTRY_DB=/data/registry.sqlite

# MCP gateway
ZSOL_MCP_STDIO=1                    # run stdio loop
ZSOL_MCP_HTTP_BIND=127.0.0.1:27014  # + streamable HTTP (JSON-RPC 2.0)
ZSOL_MCP_DRY_RUN=0                  # 1 ⇒ surface ops without sending
ZSOL_DEBUG=0                        # 1 ⇒ addresses allowed in debug logs

# Attestation identity (public label the agent registers under)
ZSOL_AGENT_ID=agent-0001

# Web (Next.js) — reads real runtime only
NEXT_PUBLIC_REGISTRY_URL=http://localhost:2730
