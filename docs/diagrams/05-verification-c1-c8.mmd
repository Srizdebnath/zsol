    SYNC --> C7["C7 freshness within maxAgeHours fail: stale-attestation"]
    SYNC --> C8["C8 presentation Ed25519 sig by sessionKey over this nonce fail: presentation-invalid"]

    C1 --> DEC{"All eight pass?"}
    C2 --> DEC
    C3 --> DEC
    C4 --> DEC
    C5 --> DEC
